/* 页面容器 */
.login-container {
  min-height: 100vh;
  background-color: #ffffff;
}

/* 第一步：初始登录页面 */
.step-one {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-container {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 48rpx;
  color: #999999;
}

.app-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
}

/* 按钮区域 */
.button-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 80rpx;
}

.btn-outline {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #07c160;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.btn-outline:active {
  background-color: #f0fff5;
}

.btn-text {
  font-size: 32rpx;
  color: #07c160;
  font-weight: 500;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
}

.btn-primary:active {
  background-color: #06ad56;
}

.btn-text-white {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 隐私协议区域 */
.privacy-section {
  width: 100%;
  display: flex;
  justify-content: center;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cccccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  transition: all 0.2s;
}

.checkbox.checked {
  background-color: #07c160;
  border-color: #07c160;
}

.check-icon {
  font-size: 24rpx;
  color: #ffffff;
}

.privacy-text {
  font-size: 24rpx;
  color: #999999;
  margin-right: 8rpx;
}

.privacy-link {
  font-size: 24rpx;
  color: #07c160;
  margin-right: 8rpx;
}

/* 第二步：编辑用户信息页面 */
.step-two {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

/* 返回按钮 */
.back-btn {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333333;
  margin-right: 12rpx;
}

.back-text {
  font-size: 32rpx;
  color: #333333;
}

/* 编辑区域 */
.edit-section {
  background-color: #f9f9f9;
  border-radius: 24rpx;
  padding: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 48rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

/* 头像上传 */
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx dashed #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploaded-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999999;
}

/* 表单输入 */
.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 48rpx;
}
