.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: 140rpx;
}

.tabs-header {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #07C160;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: #07C160;
  border-radius: 3rpx;
}

.sort-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
}

.sort-text {
  font-size: 26rpx;
  color: #666666;
}

.sort-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  color: #999999;
}

.sort-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding-top: 120rpx;
}

.sort-menu {
  background: #FFFFFF;
  margin-right: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  min-width: 280rpx;
}

.sort-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #333333;
}

.sort-item.active {
  background: #F0FDF4;
  color: #07C160;
}

.check-icon {
  color: #07C160;
  font-weight: bold;
}

.task-list {
  padding: 20rpx;
  height: calc(100vh - 220rpx);
}

.task-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #F0F0F0;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.size-tag {
  background: #F5F5F5;
  color: #666666;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.task-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reward {
  font-size: 36rpx;
  font-weight: bold;
  color: #07C160;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  background: #F0FDF4;
  color: #07C160;
}

.task-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666666;
}

.task-footer {
  border-top: 1rpx solid #F5F5F5;
  padding-top: 20rpx;
}

.claim-btn {
  width: 100%;
  background: #07C160;
  border: none;
  border-radius: 40rpx;
  padding: 22rpx;
}

.claim-btn .btn-text {
  color: white;
  font-size: 30rpx;
  font-weight: bold;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: #E5E5E5;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.modal-btn-group {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.modal-btn.cancel {
  background: #F5F5F5;
  color: #666666;
}

.modal-btn.confirm {
  background: #07C160;
  color: white;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.modal-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 32rpx;
  display: block;
  line-height: 1.6;
}

.pickup-code {
  font-size: 40rpx;
  font-weight: bold;
  color: #07C160;
  font-family: monospace;
  text-align: center;
  margin-top: 32rpx;
  margin-bottom: 32rpx;
  display: block;
}

.modal-btn {
  width: 100%;
  background: #07C160;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  display: flex;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F0F0;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-home {
  width: 44rpx;
  height: 40rpx;
  position: relative;
}

.home-roof {
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 18rpx solid #999999;
}

.nav-item.active .home-roof {
  border-bottom-color: #07C160;
}

.home-body {
  width: 38rpx;
  height: 22rpx;
  background: #999999;
  border-radius: 4rpx;
  position: absolute;
  bottom: 0;
  left: 3rpx;
}

.nav-item.active .home-body {
  background: #07C160;
}

.icon-pencil {
  width: 36rpx;
  height: 44rpx;
  position: relative;
}

.pencil-body {
  width: 16rpx;
  height: 36rpx;
  background: #999999;
  border-radius: 4rpx;
  position: absolute;
  bottom: 0;
  left: 10rpx;
}

.nav-item.active .pencil-body {
  background: #07C160;
}

.pencil-tip {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 12rpx solid #999999;
  position: absolute;
  top: 0;
  left: 10rpx;
}

.nav-item.active .pencil-tip {
  border-bottom-color: #07C160;
}

.icon-user {
  width: 40rpx;
  height: 44rpx;
  position: relative;
}

.user-head {
  width: 28rpx;
  height: 28rpx;
  background: #999999;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 6rpx;
}

.nav-item.active .user-head {
  background: #07C160;
}

.user-body {
  width: 36rpx;
  height: 20rpx;
  background: #999999;
  border-radius: 0 0 18rpx 18rpx;
  position: absolute;
  bottom: 0;
  left: 2rpx;
}

.nav-item.active .user-body {
  background: #07C160;
}

.nav-text {
  font-size: 22rpx;
  color: #999999;
}

.nav-item.active .nav-text {
  color: #07C160;
}

.nav-item.active .nav-icon {
  color: #07C160;
}

.wechat-row {
  justify-content: space-between;
}

.copy-btn {
  padding: 8rpx 20rpx;
  background: #07C160;
  color: white;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 20rpx;
  border: none;
}